phase=P01
task=P01-003
status=artifact_emitted
rule:all_universal_objects_declared=module package program world plan trace and proof objects are explicitly declared
rule:object_kind_identity_canonical=object row id must equal object kind and registry descriptor
rule:object_parentage_explicit=every non root semantic object has an explicit parent relation
rule:module_package_program_world_chain_bound=module package program and world containment chain is bound
rule:plan_trace_proof_chain_bound=plan trace and proof witness chain is bound
rule:object_serialization_uses_core_ir=semantic objects serialize through admitted core ir forms
rule:object_comparison_is_canonical=semantic object comparison uses canonical object identity only
rule:cross_layer_conformance_required=each object has a fixture proving core ir conformance
rule:no_orphan_semantic_objects=semantic object graph rejects orphan parent claims
rule:no_cycle_semantic_objects=semantic object graph rejects cycles
rule:no_network_dependency=semantic object validation runs offline
rule:no_probabilistic_object_truth=semantic object truth is symbolic deterministic and byte stable
rule:no_placeholder_objects=every semantic object row is concrete and executable
rule:no_global_closure_claim=P01 remains open after this bounded semantic object slice
