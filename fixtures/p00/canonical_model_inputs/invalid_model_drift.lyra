phase=P00
task=P00-014
status=working_slice
rule:canonical_schema_identity_required=required:each canonical data model must have a stable symbolic identity
rule:stable_field_order_required=required:canonical fields must declare explicit three digit ordering tokens
rule:explicit_required_fields_required=required:schema bindings must identify every required field by symbolic name
rule:model_source_task_required=required:each model must bind the P00 task that admitted it
rule:receipt_bound_models_required=required:model transformations must bind canonical P00 receipts
rule:no_ambient_model_defaults=required:ambient default values are allowed
rule:no_unordered_maps_in_canonical_paths=forbidden:canonical paths may rely on implicit iteration behavior
rule:phase_open_until_all_models_proven=required:P00 phase proof remains blocked until every admitted P00 task is closed
