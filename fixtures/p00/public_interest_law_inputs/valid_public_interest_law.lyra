phase=P00
task=P00-010
status=working_slice
rule:public_benefit_required=required:every governance claim binds public benefit and human agency
rule:anti_extractive_default_required=forbidden:extractive defaults profit-first governance and capture are rejected
rule:labor_participation_required=required:labor constituency receives inspect challenge and participate rights
rule:community_challenge_required=required:community and public-interest challenge paths are first-class
rule:anti_capture_required=required:platform capture vendor lock-in and private override are blocked
rule:transparent_evidence_required=required:safeguards rights and duties bind known-root evidence
rule:non_retaliation_required=required:participation rights include non-retaliation protection
rule:offline_sovereignty_required=required:cloud truth dependency and hidden network dependency are forbidden
rule:accessibility_required=required:ordinary operators can inspect challenge and understand governance surfaces
rule:stewardship_receipt_required=required:stewardship claims bind receipts and command records
