LYRA-P00-REPLAY-WITNESS v1
contract=P00-017 proof receipts and replay witnesses driver
binds=ops/p00/src/replay.rs
binds=interfaces/p00/src/replay_model.rs
binds=k0/determinism/src/replay.rs
binds=src/bin/lyra-p00-replay-check.rs
requires=proof_receipt_required
requires=canonical_preimage_required
requires=replay_witness_required
requires=receipt_chain_required
requires=witness_order_required
requires=deterministic_hash_required
requires=command_binding_required
requires=no_orphan_receipts
requires=no_mutable_replay
requires=phase_open_until_replay_proven
rejects=missing_replay_rule
rejects=missing_replay_receipt
rejects=duplicate_replay_receipt
rejects=invalid_replay_receipt
rejects=missing_replay_witness
rejects=duplicate_replay_witness
rejects=invalid_replay_witness
rejects=missing_receipt_chain_binding
rejects=duplicate_receipt_chain_binding
rejects=invalid_receipt_chain_binding
rejects=missing_replay_proof
rejects=replay_proof_unbound
rejects=orphan_receipt_binding
rejects=replay_drift_accepted
rejects=receipt_hash_mismatch
closure=blocked_until_all_p00_tasks_are_receipted_and_replayed
receipt=constitutional_receipt
receipt=authority_receipt
receipt=identity_receipt
receipt=enforcement_receipt
receipt=delivery_receipt
receipt=challenge_receipt
receipt=control_receipt
receipt=owner_root_receipt
receipt=benchmark_evidence_receipt
receipt=public_interest_receipt
receipt=canon_compliance_receipt
receipt=acceptance_receipt
receipt=formal_semantics_receipt
receipt=canonical_model_receipt
receipt=deterministic_engine_receipt
receipt=falsification_receipt
receipt=replay_driver_receipt
witness=canonical_replay
witness=authority_replay
witness=control_replay
witness=engine_replay
witness=falsification_replay
witness=receipt_chain_replay
link=constitution_to_authority
link=authority_to_identity
link=identity_to_enforcement
link=enforcement_to_delivery
link=delivery_to_challenge
link=challenge_to_control
link=control_to_owner_root
link=owner_root_to_benchmark_evidence
link=benchmark_evidence_to_public_interest
link=public_interest_to_canon_compliance
link=canon_compliance_to_acceptance
link=acceptance_to_formal_semantics
link=formal_semantics_to_canonical_model
link=canonical_model_to_engine
link=engine_to_falsification
link=falsification_to_replay_driver
proof=replay_local_execution
proof=receipt_chain_integrity
proof=witness_hash_stability
proof=p00_phase_open
